# Backend environment example for local development.
# Copy to server/.env and replace placeholders with local/test values.
# Never commit real API keys, DB passwords, JWT secrets, webhook secrets, or AWS credentials.

# Runtime
APP_STATE=dev
LISTEN=8080
LISTEN___=3000
CLIK_URL=http://localhost:5173
CLIK_URL_L=http://localhost:5173

# Database
HOST_DATABASE=localhost
USER_DATABASE=clikb_user
PASSWORD_DATABASE=replace_me
DATABASE_NAME=clikb_dev

# Auth
SECRET_KEYY=replace_with_a_long_random_local_secret

# OpenAI / model orchestration
DALLE_KEY=
OPENAI_API_KEY=
OPENIMAGE_KEY=
APP_STATE_STABLE_KEY=
OPEN_KEY=https://api.openai.com/v1/images/generations

# RAG / Pinecone
PINECONE_API_KEY=
PINECONE_KEY=
PINECONE_INDEX=clikb-knowledge
PINECONE_NAMESPACE=clikbKnowledge
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=6
RAG_MIN_SCORE=0.2
RAG_MAX_CHUNKS=4

# Voice / STT / TTS
GOOGLE_LIVE_KEY=
GOOGLE_TTS_KEY=
GOOGLE_KEY=
VOICE_STT_PROVIDER=gemini
GROK_KEY=
XAI_API_KEY=
XAI_SMART_TURN=0.7
XAI_SMART_TURN_TIMEOUT=3000
XAI_STT_KEYTERMS=ClikB,Brainstorm,Shorts,Cinema,Games

# Media providers
FAL_KEY=
PI_KEY=
REPLI_KEY=
REPLICATE_API_TOKEN=
REPLICATE_GPT4O_MINI_TRANSCRIBE_VERSION=
HUGGINGFACE_TOKEN=

# AWS media storage and processing
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=
BUCKET_REGION=us-east-1
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
MEDIA_CONVERT_ENDPOINT=
MEDIA_CONVERT_ROLE=
MEDIACONVERT_ROLE_ARN=
OUTPUT_BUCKET=
LAMBDA_FFMPEG_FUNCTION_NAME=clikb-ffmpeg
LAMBDA_STATUS_BUCKET=
LAMBDA_STATUS_PREFIX=lambda-ffmpeg-status/
LAMBDA_OUTPUT_BUCKET=
LAMBDA_OUTPUT_PREFIX=lambda-ffmpeg/

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_WEBHOOK_SECRET_L=whsec_replace_me
