# Frontend environment example for local development.
# Copy to .env and replace placeholders with local/test values.
# VITE_* variables are public in the browser bundle. Do not place private secrets here.

VITE_CLIK_URL=http://localhost:8080
VITE_APPX_STATE=dev
VITE__CLOUNDFRONT=https://example-cloudfront-domain.example.com/

# Public browser/client IDs only.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_STRIPE_PUBLISH=pk_test_replace_me

# Legacy/prototype client-side provider variables used by some components.
# Keep these empty unless you understand that VITE_* values are exposed to users.
VITE_HUGG=
VITE_REPLI_KEY=
VITE_ELEVEN_KEY=
VITE_GOOGLE_TTS=
VITE_GOOGLE_KEY=
VITE_FLUX_KEY=
