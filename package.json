{
  "name": "clikit-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:seo": "node scripts/generate-public-pages.mjs",
    "prebuild": "npm run generate:seo",
    "start:front": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:scene-targets": "tsc -p tsconfig.scene-target-tests.json && node node_modules/.tmp/scene-target-tests/tests/sceneTargetArchitecture.test.js",
    "test:navigation-snapshot": "tsc -p tsconfig.navigation-snapshot-tests.json && node node_modules/.tmp/navigation-snapshot-tests/tests/navigationControlSnapshot.test.js",
    "test:feeds-snapshot": "tsc -p tsconfig.feeds-snapshot-tests.json && node node_modules/.tmp/feeds-snapshot-tests/tests/feedsControlSnapshot.test.js",
    "test:motion-guide": "node --test tests/motionGuide.test.cjs",
    "test:spatial-world": "node --test tests/spatialWorld.test.cjs",
    "test:creation-regressions": "node --test tests/creationRegressions.test.cjs",
    "test:touch-interactions": "tsc -p tsconfig.touch-interaction-tests.json && node node_modules/.tmp/touch-interaction-tests/tests/touchHoldPlayback.test.js",
    "test:interaction-graph": "tsc -p tsconfig.interaction-graph-tests.json && node node_modules/.tmp/interaction-graph-tests/tests/interactionGraph.test.js",
    "test:asset-cache": "tsc -p tsconfig.interaction-cache-tests.json && node node_modules/.tmp/interaction-cache-tests/tests/interactionAssetCache.test.js",
    "test:intent-blueprint": "tsc -p tsconfig.intent-blueprint-tests.json && node node_modules/.tmp/intent-blueprint-tests/tests/intentBlueprint.test.js",
    "test:drag-hold": "tsc -p tsconfig.drag-hold-tests.json && node node_modules/.tmp/drag-hold-tests/tests/dragHoldPlayback.test.js",
    "test:spatial-stage": "tsc -p tsconfig.spatial-stage-tests.json && node node_modules/.tmp/spatial-stage-tests/tests/spatialStageModel.test.js"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.0",
    "@google/genai": "^2.10.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@react-oauth/google": "^0.12.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.4.0",
    "@types/three": "^0.185.4",
    "axios": "^1.10.0",
    "framer-motion": "^11.17.0",
    "jwt-decode": "^4.0.0",
    "mediabunny": "^1.61.0",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.4.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/axios": "^0.9.36",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
